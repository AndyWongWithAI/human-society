/* Layer tabs - horizontal scroll */
.layer-tabs {
  display: flex;
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
  padding: 4px 0;
}
.layer-tab {
  display: inline-block;
  padding: 12px 16px;
  font-size: 13px;
  font-weight: 600;
  color: #718096;
  border-bottom: 4rpx solid transparent;
  flex-shrink: 0;
}
.layer-tab.active {
  color: #5B8FF9;
  border-bottom-color: #5B8FF9;
}

/* Search */
.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  padding: 8px 16px;
  border-bottom: 1rpx solid #e2e8f0;
}
.search-bar input {
  flex: 1;
  height: 32px;
  font-size: 13px;
}
.clear-btn {
  font-size: 16px;
  color: #a0aec0;
  padding: 4px 8px;
}

/* Entity list */
.entity-list {
  flex: 1;
  background: #fff;
}
.entity-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 14px 16px;
  border-bottom: 1rpx solid #f0f0f5;
}
.entity-item.active {
  background: #eef2ff;
  border-left: 6rpx solid #5B8FF9;
}
.entity-item .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-top: 6px;
  flex-shrink: 0;
}
.entity-item .info {
  flex: 1;
  min-width: 0;
}
.entity-item .name {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
}
.entity-item .meta-line {
  font-size: 11px;
  color: #718096;
  margin-top: 3px;
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}
.entity-item .meta-line .sep {
  margin: 0 2px;
}
.entity-item .status {
  font-size: 9px;
  padding: 1px 6px;
  border-radius: 8px;
}
.entity-item .date {
  font-size: 10px;
  color: #a0aec0;
}
.entity-item .new-badge {
  font-size: 9px;
  font-weight: 700;
  padding: 1px 5px;
  border-radius: 4px;
  background: #FED7D7;
  color: #C53030;
}
.entity-item .excerpt {
  font-size: 12px;
  color: #a0aec0;
  margin-top: 4px;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Stats */
.stats-bar {
  text-align: center;
  font-size: 11px;
  color: #a0aec0;
  padding: 12px;
  background: #f8f9fa;
}

/* Header row in search results */
.header-row {
  padding: 8px 16px;
  font-size: 11px;
  font-weight: 700;
  color: #718096;
  background: #f7fafc;
  border-bottom: 1rpx solid #e2e8f0;
}
